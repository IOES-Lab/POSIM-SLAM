<?xml version='1.0' encoding='utf-8'?>
<sdf xmlns:gz="http://gazebosim.org" version="1.10"><world name="dvl_test"><scene><ambient>0.4 0.4 0.4</ambient><background>0.3 0.3 0.3</background></scene><plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" /><gravity>0 0 0</gravity><physics name="default" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics><plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" /><plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin><model name="bottom"><static>true</static><link name="floor"><collision name="floor"><geometry><box><size>100 100 1</size></box></geometry></collision><visual name="floor"><geometry><box><size>100 100 1</size></box></geometry></visual></link></model><model name="bluerov2"><link name="base_link"><inertial><mass>1</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><sensor name="practice_dvl" type="custom" gz:type="dvl"><pose>0 0 -0.12 0 0 0</pose><always_on>true</always_on><update_rate>1</update_rate><topic>/model/bluerov2/slam/dvl</topic><gz:dvl><type>phased_array</type><arrangement degrees="true"><beam id="1"><aperture>2</aperture><rotation>45</rotation><tilt>30</tilt></beam><beam id="2"><aperture>2</aperture><rotation>135</rotation><tilt>30</tilt></beam><beam id="3"><aperture>2</aperture><rotation>-45</rotation><tilt>30</tilt></beam><beam id="4"><aperture>2</aperture><rotation>-135</rotation><tilt>30</tilt></beam></arrangement><tracking><bottom_mode><when>best</when><noise type="gaussian"><stddev>0.002</stddev></noise><visualize>false</visualize></bottom_mode></tracking><resolution>0.01</resolution><maximum_range>20</maximum_range><minimum_range>0.1</minimum_range><reference_frame>0 0 0 0 0 0</reference_frame></gz:dvl></sensor><sensor name="render_init" type="camera"><always_on>true</always_on><update_rate>1</update_rate><camera><image><width>64</width><height>48</height></image></camera></sensor></link><plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><initial_linear>0.4 -0.2 0.0</initial_linear></plugin><pose>0 0 2.0 0 0 0</pose></model><plugin filename="gz-sim-dvl-system" name="gz::sim::systems::DopplerVelocityLogSystem" /></world></sdf>